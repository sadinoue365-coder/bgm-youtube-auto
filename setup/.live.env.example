# =====================================================
# YouTube Live 配信設定  (setup/.live.env)
# =====================================================
# このファイルを setup/.live.env にコピーして値を埋めてください。
# .live.env は .gitignore 対象のため、Git には追加されません。
#
# ストリームキーの取得方法:
#   YouTube Studio → ライブ配信 → ストリーム → ストリームキー (コピー)
#   ※「永続ストリームキーを使用する」をONにすること
# =====================================================

# ── Jazz チャンネル ──────────────────────────────────
JAZZ_LIVE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx
JAZZ_CLIENT_SECRET_JSON={"installed":{"client_id":"...","client_secret":"...","redirect_uris":["urn:ietf:wg:oauth:2.0:oob"],"auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}}
JAZZ_REFRESH_TOKEN=1//xxxxxxxxxxxx
JAZZ_GDRIVE_FOLDER_ID=xxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cafe チャンネル ──────────────────────────────────
CAFE_LIVE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx
CAFE_CLIENT_SECRET_JSON={"installed":{"client_id":"...","client_secret":"...","redirect_uris":["urn:ietf:wg:oauth:2.0:oob"],"auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}}
CAFE_REFRESH_TOKEN=1//xxxxxxxxxxxx
CAFE_GDRIVE_FOLDER_ID=xxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sleep チャンネル ─────────────────────────────────
SLEEP_LIVE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx
SLEEP_CLIENT_SECRET_JSON={"installed":{"client_id":"...","client_secret":"...","redirect_uris":["urn:ietf:wg:oauth:2.0:oob"],"auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}}
SLEEP_REFRESH_TOKEN=1//xxxxxxxxxxxx
SLEEP_GDRIVE_FOLDER_ID=xxxxxxxxxxxxxxxxxxxxxxxxx
